function parseBulk(text) {
  const blocks = text.split(/\n\s*\n/).map(b => b.trim()).filter(Boolean);
  const out = [];
  for (const block of blocks) {
    const lines = block.split('\n').map(l => l.trim()).filter(Boolean);
    if (!lines.length) continue;
    const stem = lines[0].replace(/^[Qq]\d*[\).:\-]\s*/, '').trim();
    if (!stem) continue;

    const options = [];
    let answerText = '';

    for (const line of lines.slice(1)) {
      const mAns = line.match(/^(?:ans|answer|جواب)\s*[:=\-]\s*(.+)$/i);
      if (mAns) { answerText = mAns[1].trim(); continue; }
      const isCorrect = /^[*+]/.test(line);
      let opt = line.replace(/^[*+]\s*/, '');
      opt = opt.replace(/^[A-Ha-h][\).]\s*/, '').trim();
      if (!opt) continue;
      options.push({ text: opt, correct: isCorrect });
    }

    const q = {
      id: uid(),
      subject: $('#bkSubject').value.trim(),
      chapter: $('#bkChapter').value.trim(),
      medium: $('#bkMedium').value,
      section: $('#bkSection').value.trim(),
      marks: Math.max(1, +$('#bkMarks').value || 1),
      text: stem, options: [], answer: ''
    };

    if (options.length >= 2) {
      q.type = 'mcq';
      q.options = options.map(o => o.text);
      let idx = options.findIndex(o => o.correct);
      if (idx < 0) idx = 0;
      q.answer = idx;
    } else {
      q.type = 'short';
      q.answer = answerText || (options[0]?.text ?? '');
    }
    out.push(q);
  }
  return out;
}

$('#bulkForm').onsubmit = e => {
  e.preventDefault();
  const parsed = parseBulk($('#bkText').value);
  if (!parsed.length) { alert('Nothing could be parsed. Check the format.'); return; }
  state.questions.push(...parsed);
  saveState();
  $('#bulkDlg').close();
  renderBank();
  alert(`Added ${parsed.length} question${parsed.length > 1 ? 's' : ''}.`);
};

