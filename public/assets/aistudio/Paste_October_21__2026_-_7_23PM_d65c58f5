let state = { questions: [], config: {}, selected: [] };

function loadState() {
  try {
    const raw = localStorage.getItem(STORE);
    if (raw) {
      const p = JSON.parse(raw);
      // If for some reason the questions array is empty, reload defaults
      if (Array.isArray(p.questions) && p.questions.length > 0) {
        state.questions = p.questions;
        state.config    = p.config || {};
        state.selected  = Array.isArray(p.selected) ? p.selected : [];
        return;
      }
    }
  } catch (e) { console.warn('load failed', e); }
  state.questions = DEFAULT_QUESTIONS;
  state.selected = [];
}

function saveState() {
  try { localStorage.setItem(STORE, JSON.stringify(state)); }
  catch (e) { alert('Could not save to browser storage. Export your bank as JSON to keep it safe.'); }
}

