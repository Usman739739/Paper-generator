/* =========================================================
   PAPER GENERATION
   ========================================================= */
function makeVariant(questions, opts) {
  const grouped = {};
  questions.forEach(q => {
    const s = q.section || 'Questions';
    if (!grouped[s]) grouped[s] = [];
    grouped[s].push(q);
  });

  return Object.keys(grouped).map(sec => {
    let qs = grouped[sec];
    if (opts.shuffleQuestions) qs = shuffle(qs);

    const processedQs = qs.map(q => {
      const copy = { ...q, options: [...(q.options || [])] };
      if (opts.shuffleOptions && copy.type === 'mcq' && copy.options.length > 1) {
        const perm = shuffle(copy.options.map((_, i) => i));
        copy.options = perm.map(i => q.options[i]);
        copy.answer = perm.indexOf(q.answer);
      }
      return copy;
    });
    return { section: sec, questions: processedQs };
  });
}

function variantLabels(medium) {
  if (medium === 'urdu') return ['ورژن الف', 'ورژن ب', 'ورژن ج'];
  return ['Variant A', 'Variant B', 'Variant C'];
}

function renderPaperHeader(cfg, variantLabel, totalMarks) {
  const m = cfg.cMedium;
  const L = k => t(k, m);
  
  return `
    <div class="paper-head">
      <div class="head-top">
        ${cfg.cSchool ? `<span class="school ${m==='urdu'?'urdu':''}">${esc(cfg.cSchool)}</span>` : ''}
        ${cfg.cTitle ? `<span class="exam ${m==='urdu'?'urdu':''}">${esc(cfg.cTitle)}</span>` : ''}
        ${variantLabel ? `<span class="variant-tag ${m==='urdu'?'urdu':''}">${esc(variantLabel)}</span>` : ''}
      </div>
      ${cfg.cChapter ? `<div class="chapter ${m==='urdu'?'urdu':''}">${esc(cfg.cChapter)}</div>` : ''}
      <div class="meta">
        ${cfg.cClass    ? `<span><b>${L('class')}:</b> ${esc(cfg.cClass)}</span>` : ''}
        ${cfg.cSubject  ? `<span><b>${L('subject')}:</b> ${esc(cfg.cSubject)}</span>` : ''}
        ${cfg.cDuration ? `<span><b>${L('time')}:</b> ${esc(cfg.cDuration)}</span>` : ''}
        <span><b>${L('totalMarks')}:</b> ${totalMarks}</span>
      </div>
    </div>`;
}

function renderQuestion(q, i, cfg) {
  const isRTL = RTL_RE.test(q.text) || (Array.isArray(q.options) && q.options.some(o => RTL_RE.test(o)));
  const dir = isRTL ? 'rtl' : 'ltr';
  const cls = isRTL ? 'urdu' : '';
  const letters = isRTL ? URDU_LETTERS : LETTERS;
  const showMarks = cfg.cMarks;

  let h = `<li class="question" dir="${dir}">`;
  h += `<div class="q-head">
          <span class="q-num">${i}.</span>
          <span class="q-text ${cls}">${nl2br(q.text)}</span>
          ${showMarks ? `<span class="q-marks">[${q.marks || 1}]</span>` : ''}
        </div>`;

  if (q.type === 'mcq') {
    const cols = Math.min(4, Math.max(1, +cfg.cCols || 2));
    h += `<div class="options cols-${cols}">` +
      (q.options || []).map((o, oi) =>
        `<div class="opt"><span class="opt-key">${letters[oi] || ''}</span><span class="${cls}">${esc(o)}</span></div>`
      ).join('') + `</div>`;
  }
  return h + `</li>`;
}

function renderMiniPaper(variantData, cfg, variantLabel, totalMarks) {
  const m = cfg.cMedium;
  const dir = m === 'urdu' ? 'rtl' : 'ltr';
  const cls = m === 'urdu' ? 'urdu' : '';
  
  let qIndex = 1;
  let questionsHtml = '';
  
  variantData.forEach(group => {
    if (!group.questions.length) return;
    if (group.section && group.section.trim()) {
      questionsHtml += `<div class="section-title">${esc(group.section)}</div>`;
    }
    questionsHtml += `<ol class="questions">`;
    group.questions.forEach(q => {
      questionsHtml += renderQuestion(q, qIndex++, cfg);
    });
    questionsHtml += `</ol>`;
  });

  return `<div class="mini-paper ${cls}" dir="${dir}">
      ${renderPaperHeader(cfg, variantLabel, totalMarks)}
      ${questionsHtml}
    </div>`;
}

function renderAnswerKey(variantData, cfg, label) {
  const m = cfg.cMedium;
  const dir = m === 'urdu' ? 'rtl' : 'ltr';
  const cls = m === 'urdu' ? 'urdu' : '';
  
  let qIndex = 1;
  let keyHtml = '';
  
  variantData.forEach(group => {
    if (!group.questions.length) return;
    if (group.section && group.section.trim()) {
      keyHtml += `<div class="section-title">${esc(group.section)}</div>`;
    }
    keyHtml += `<div class="key-block">`;
    group.questions.forEach(q => {
      const isRTL = RTL_RE.test(q.text) || (q.options||[]).some(o => RTL_RE.test(o));
      const letters = isRTL ? URDU_LETTERS : LETTERS;
      let a;
      if (q.type === 'mcq') {
        a = letters[q.answer] ?? '?';
        if (q.options?.[q.answer]) a += `. ${esc(q.options[q.answer])}`;
      } else {
        a = esc(q.answer || '—');
      }
      keyHtml += `<div class="key-line">
        <span class="key-num">${qIndex++}.</span>
        <span class="${isRTL ? 'urdu' : ''}">${a}</span>
      </div>`;
    });
    keyHtml += `</div>`;
  });

  return `<div class="sheet-frame">
    <div class="mini-paper key ${cls}" dir="${dir}">
      <div class="paper-head">
        <div class="head-top">
          <span class="school">${t('answerKey', m)}</span>
          <span class="exam ${cls}">${esc(label)}</span>
        </div>
      </div>
      ${keyHtml}
    </div>
  </div>`;
}

// Auto-fit algorithm for tiled layouts
function autoFitTiles() {
  const per = +$('#cPerSheet').value || 1;
  if (per === 1) return; 

  const baseSize = per === 2 ? 12 : (per === 4 ? 10 : 14);
  const minSize = 6;

  $$('.mini-paper').forEach(mp => {
    mp.style.fontSize = `${baseSize}px`;
    let currentSize = baseSize;
    
    while (mp.scrollHeight > mp.clientHeight + 2 && currentSize > minSize) {
      currentSize -= 0.5;
      mp.style.fontSize = `${currentSize}px`;
    }
  });
}

function generatePaper() {
  const cfg = readConfig();
  state.config = cfg; saveState();

  const chosen = state.selected.map(id => state.questions.find(q => q.id === id)).filter(Boolean);
  if (!chosen.length) { alert('Select at least one question first.'); return; }

  const totalMarks = chosen.reduce((a, q) => a + (q.marks || 1), 0);
  const V  = Math.min(3, Math.max(1, +cfg.cVariants || 1));
  const per = +cfg.cPerSheet || 1;
  const arr = cfg.cArr || 'stack';
  const opts = { shuffleQuestions: cfg.cShuffleQ, shuffleOptions: cfg.cShuffleO };
  const labels = variantLabels(cfg.cMedium);

  const variants = [];
  for (let v = 0; v < V; v++) variants.push(makeVariant(chosen, opts));

  const sheets = Math.ceil(V / per);
  const parts = [];
  for (let s = 0; s < sheets; s++) {
    let tiles = '';
    for (let slot = 0; slot < per; slot++) {
      const v = (s * per + slot) % V;
      const label = V > 1 ? labels[v] : '';
      tiles += renderMiniPaper(variants[v], cfg, label, totalMarks);
    }
    parts.push(`<div class="sheet-frame">
      <div class="sheet" data-per="${per}" data-arr="${arr}">${tiles}</div>
    </div>`);
  }

  if (cfg.cKey) {
    for (let v = 0; v < V; v++) {
      parts.push(renderAnswerKey(variants[v], cfg, V > 1 ? labels[v] : t('answerKey', cfg.cMedium)));
    }
  }

  $('#paperRoot').innerHTML = parts.join('');
  showView('preview');

  // Apply Auto-Fit after rendering
  requestAnimationFrame(() => {
    autoFitTiles();
    
    let overflow = 0;
    if (per > 1) {
      $$('.sheet .mini-paper').forEach(mp => {
        if (mp.scrollHeight > mp.clientHeight + 2) overflow++;
      });
    }
    const note = `${chosen.length} questions · ${totalMarks} marks · ${V} variant${V>1?'s':''} · ` +
                 `${sheets} master sheet${sheets>1?'s':''} (${per} per sheet)`;
    $('#previewNote').innerHTML = overflow
      ? `<span style="color:var(--danger);font-weight:600;">⚠ ${overflow} tile(s) overflow even after auto-fit. Reduce questions.</span>`
      : `<span style="color:var(--success);font-weight:600;">✓ All items fit perfectly.</span>`;
  });
}

$('#btnGenerate').onclick = generatePaper;
$('#btnPrint').onclick = () => window.print();

