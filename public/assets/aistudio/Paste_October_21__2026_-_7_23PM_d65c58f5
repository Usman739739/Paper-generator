.sheet{ display:grid; }
.sheet[data-per="1"]{ grid-template:1fr/1fr; }
.sheet[data-per="2"][data-arr="stack"]{ grid-template:1fr 1fr/1fr; height:calc(var(--ph) - var(--my)*2 - 2mm); }
.sheet[data-per="2"][data-arr="side"] { grid-template:1fr/1fr 1fr; height:calc(var(--ph) - var(--my)*2 - 2mm); }
.sheet[data-per="4"]{ grid-template:1fr 1fr/1fr 1fr; height:calc(var(--ph) - var(--my)*2 - 2mm); }

