/* =========================================================
   Font loading (IndexedDB)
   ========================================================= */
const FONT_DB = 'tpg-fonts', FONT_STORE = 'font';
function openFontDB() {
  return new Promise((res, rej) => {
    const r = indexedDB.open(FONT_DB, 1);
    r.onupgradeneeded = () => r.result.createObjectStore(FONT_STORE);
    r.onsuccess = () => res(r.result);
    r.onerror = () => rej(r.error);
  });
}
async function saveFont(buf, name) {
  const db = await openFontDB();
  return new Promise((res, rej) => {
    const tx = db.transaction(FONT_STORE, 'readwrite');
    tx.objectStore(FONT_STORE).put({ buf, name }, 'urdu');
    tx.oncomplete = res;
    tx.onerror = () => rej(tx.error);
  });
}
async function readFont() {
  const db = await openFontDB();
  return new Promise((res, rej) => {
    const tx = db.transaction(FONT_STORE, 'readonly');
    const req = tx.objectStore(FONT_STORE).get('urdu');
    req.onsuccess = () => res(req.result);
    req.onerror = () => rej(req.error);
  });
}
async function registerFont(buf) {
  const face = new FontFace('UserUrdu', buf);
  await face.load();
  document.fonts.add(face);
}

async function bootFont() {
  try {
    const r = await readFont();
    if (r && r.buf) {
      await registerFont(r.buf);
      $('#btnFont').innerHTML = '🔤 Font ✓';
      $('#btnFont').title = 'Loaded: ' + r.name;
    }
  } catch (e) { /* no stored font */ }
}

$('#btnFont').onclick = () => $('#fileFont').click();
$('#fileFont').onchange = async e => {
  const f = e.target.files[0];
  if (!f) return;
  try {
    const buf = await f.arrayBuffer();
    await registerFont(buf);
    await saveFont(buf, f.name);
    $('#btnFont').innerHTML = '🔤 Font ✓';
    $('#btnFont').title = 'Loaded: ' + f.name;
    alert('Urdu font loaded and saved. It will load automatically next time.');
    if ($('#view-preview').classList.contains('active')) generatePaper();
  } catch (err) {
    alert('Could not load that font file: ' + err.message);
  }
  e.target.value = '';
};

